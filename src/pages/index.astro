---
import Layout from '../layouts/Layout.astro';

const features = [
	{
		title: 'Resiliente ante huracanes',
		desc: 'Sigue comunicado cuando la red celular y el internet caen. Diseñado para emergencias como María, Fiona y los próximos eventos.',
	},
	{
		title: 'Sin internet ni torres celulares',
		desc: 'Cada dispositivo es un nodo. Los mensajes saltan de nodo a nodo (mesh) usando radios LoRa de largo alcance.',
	},
	{
		title: 'Código abierto',
		desc: 'Firmware y protocolo abiertos. Cualquiera puede auditar, mejorar y correr su propio nodo.',
	},
	{
		title: 'Largo alcance, bajo consumo',
		desc: 'Los radios LoRa alcanzan varios kilómetros por salto con muy poco consumo de batería.',
	},
];

const steps = [
	{
		n: '01',
		title: 'Consigue hardware compatible',
		desc: 'Un dispositivo ESP32 o nRF52 con módulo LoRa (ej. Heltec, RAK, LilyGO) sintonizado a la frecuencia usada en PR.',
	},
	{
		n: '02',
		title: 'Instala el firmware MeshCore',
		desc: 'Flashea tu dispositivo con el firmware de MeshCore y configúralo con tu nombre de nodo.',
	},
	{
		n: '03',
		title: 'Únete al canal de Puerto Rico',
		desc: 'Configura el canal/clave pública de la comunidad para empezar a ver y repetir mensajes de otros nodos en la isla.',
	},
	{
		n: '04',
		title: 'Suma tu nodo a la red',
		desc: 'Coloca tu nodo en alto (azotea, balcón, cerro) para ampliar la cobertura de todos los que ya están en la red.',
	},
];
---

<Layout>
	<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur">
		<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
			<a href="#top" class="flex items-center gap-2 font-semibold tracking-tight">
				<span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
				MeshCore<span class="text-emerald-400">PR</span>
			</a>
			<div class="hidden gap-8 text-sm text-slate-300 sm:flex">
				<a href="#que-es" class="hover:text-white">Qué es</a>
				<a href="#como-unirte" class="hover:text-white">Cómo unirte</a>
				<a href="#cobertura" class="hover:text-white">Cobertura</a>
				<a href="#comunidad" class="hover:text-white">Comunidad</a>
			</div>
			<a
				href="#como-unirte"
				class="rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-emerald-300"
			>
				Únete a la red
			</a>
		</nav>
	</header>

	<main id="top">
		<!-- Hero -->
		<section class="relative overflow-hidden px-6 py-24 sm:py-32">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(16,185,129,0.15),transparent_60%)]"
			>
			</div>
			<div class="relative mx-auto max-w-4xl text-center">
				<p class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-1 text-xs font-medium text-emerald-300">
					Proyecto comunitario · Puerto Rico
				</p>
				<h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
					Comunicación que no se cae<br class="hidden sm:block" />
					cuando la isla se queda sin señal
				</h1>
				<p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
					MeshCore Puerto Rico es una red mesh de radios LoRa construida por la comunidad.
					Sin internet, sin torres celulares, sin compañías de por medio — solo vecinos
					repitiendo mensajes entre nodos.
				</p>
				<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
					<a
						href="#como-unirte"
						class="w-full rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-300 sm:w-auto"
					>
						Cómo unirte a la red
					</a>
					<a
						href="#que-es"
						class="w-full rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/5 sm:w-auto"
					>
						Qué es MeshCore
					</a>
				</div>
			</div>
		</section>

		<!-- Qué es -->
		<section id="que-es" class="border-t border-white/10 px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Qué es</h2>
				<p class="mt-2 max-w-3xl text-2xl font-semibold sm:text-3xl">
					Una red de radios que se cubren los unos a los otros.
				</p>
				<p class="mt-4 max-w-3xl text-slate-400">
					MeshCore es un protocolo y firmware de código abierto para redes mesh sobre LoRa.
					Cada dispositivo (nodo) recibe y retransmite mensajes de texto a otros nodos dentro
					de su alcance, extendiendo la cobertura sin depender de infraestructura centralizada.
				</p>
				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{features.map((f) => (
						<div class="rounded-2xl border border-white/10 bg-white/5 p-6">
							<h3 class="font-semibold text-white">{f.title}</h3>
							<p class="mt-2 text-sm text-slate-400">{f.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Cómo unirte -->
		<section id="como-unirte" class="border-t border-white/10 px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Cómo unirte</h2>
				<p class="mt-2 max-w-3xl text-2xl font-semibold sm:text-3xl">
					Pon tu nodo en el aire en cuatro pasos.
				</p>
				<div class="mt-12 grid gap-8 sm:grid-cols-2">
					{steps.map((s) => (
						<div class="flex gap-4">
							<span class="text-3xl font-bold text-emerald-400/50">{s.n}</span>
							<div>
								<h3 class="font-semibold text-white">{s.title}</h3>
								<p class="mt-1 text-sm text-slate-400">{s.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Cobertura -->
		<section id="cobertura" class="border-t border-white/10 px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Cobertura</h2>
				<p class="mt-2 max-w-3xl text-2xl font-semibold sm:text-3xl">
					Mapa de nodos en construcción.
				</p>
				<div class="mt-8 flex flex-col items-start gap-4 rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 sm:flex-row sm:items-center sm:justify-between">
					<p class="max-w-xl text-slate-400">
						Estamos levantando el mapa de nodos activos en la isla. Si tienes un nodo
						corriendo, súmalo a la comunidad para que aparezca aquí.
					</p>
					<a
						href="#comunidad"
						class="shrink-0 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
					>
						Registrar mi nodo
					</a>
				</div>
			</div>
		</section>

		<!-- Comunidad -->
		<section id="comunidad" class="border-t border-white/10 px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Comunidad</h2>
				<p class="mt-2 max-w-3xl text-2xl font-semibold sm:text-3xl">
					Coordinamos repetidores y cobertura entre todos.
				</p>
				<p class="mt-4 max-w-2xl text-slate-400">
					Únete al chat de la comunidad para coordinar ubicación de repetidores, resolver
					dudas de configuración y enterarte de activaciones durante emergencias.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href="#"
						class="rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-300"
					>
						Unirme al chat
					</a>
					<a
						href="#"
						class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/5"
					>
						Escribir por correo
					</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-white/10 px-6 py-10">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-slate-500 sm:flex-row">
			<p>MeshCore Puerto Rico — proyecto comunitario, código abierto.</p>
			<p>Hecho por y para la comunidad de la isla.</p>
		</div>
	</footer>
</Layout>
