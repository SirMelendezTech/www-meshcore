---
import Layout from '../layouts/Layout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { linkAttrs } from '../config/links';
import { homePath, languages, protocolsPath, type Lang } from '../i18n/ui';
import { protocolos } from '../i18n/protocolos';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = protocolos[lang];
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
const home = homePath[lang];

// PRMSH colour convention: teal marks MeshCore, lime marks Meshtastic.
// MeshCore goes first: it's what this site is about.
const pairs = (s: { meshcore: Col; meshtastic: Col }) => [
	{ ...s.meshcore, tone: 'mc' },
	{ ...s.meshtastic, tone: 'mt' },
];
type Col = { title: string; items: string[] };
---

<Layout
	lang={lang}
	title={t.meta.title}
	description={t.meta.description}
	alternates={protocolsPath}
>
	<SiteHeader lang={lang} altHref={protocolsPath[otherLang]} />

	<main id="contenido">
		<section class="intro" aria-labelledby="cmp-title">
			<div class="container">
				<p class="intro__eyebrow mono">{t.hero.eyebrow}</p>
				<h1 id="cmp-title">{t.hero.title}</h1>
				<p class="intro__lead">{t.hero.lead}</p>
				<p class="intro__checked mono">{t.hero.checked}</p>
			</div>
		</section>

		<section id="corto" class="section" aria-labelledby="corto-title">
			<div class="container">
				<header class="section-head">
					<h2 id="corto-title">{t.corto.title}</h2>
				</header>
				<div class="cols">
					{pairs(t.corto).map((c) => (
						<div class:list={['col', `col--${c.tone}`]}>
							<h3>{c.title}</h3>
							<ul class="bullets">
								{c.items.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</div>
					))}
				</div>
				<p class="callout" set:html={t.corto.incompatHtml} />
			</div>
		</section>

		<section id="tabla" class="section" aria-labelledby="tabla-title">
			<div class="container">
				<header class="section-head">
					<h2 id="tabla-title">{t.tabla.title}</h2>
				</header>
				<div class="table-wrap" tabindex="0" role="region" aria-labelledby="tabla-title">
					<table class="compare">
						<thead>
							<tr>
								<th scope="col">{t.tabla.feature}</th>
								<th scope="col" class="th--mc">
									MeshCore
								</th>
								<th scope="col" class="th--mt">
									Meshtastic
								</th>
							</tr>
						</thead>
						<tbody>
							{t.tabla.rows.map((r) => (
								<tr>
									<th scope="row">{r.k}</th>
									<td>{r.mc}</td>
									<td>{r.mt}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section id="ruteo" class="section" aria-labelledby="ruteo-title">
			<div class="container">
				<header class="section-head">
					<h2 id="ruteo-title">{t.ruteo.title}</h2>
				</header>
				<div class="cols">
					{pairs(t.ruteo).map((c) => (
						<div class:list={['col', `col--${c.tone}`]}>
							<h3>{c.title}</h3>
							<ul class="rows">
								{c.items.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="alcance" class="section" aria-labelledby="alcance-title">
			<div class="container split">
				<h2 id="alcance-title">{t.alcance.title}</h2>
				<div class="prose">
					{t.alcance.paragraphs.map((p) => (
						<p>{p}</p>
					))}
				</div>
			</div>
		</section>

		<section id="cifrado" class="section" aria-labelledby="cifrado-title">
			<div class="container">
				<header class="section-head">
					<h2 id="cifrado-title">{t.cifrado.title}</h2>
				</header>
				<div class="cols">
					{pairs(t.cifrado).map((c) => (
						<div class:list={['col', `col--${c.tone}`]}>
							<h3>{c.title}</h3>
							<ul class="rows">
								{c.items.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</div>
					))}
				</div>
				<p class="callout">{t.cifrado.ambos}</p>
			</div>
		</section>

		<section id="apps" class="section" aria-labelledby="apps-title">
			<div class="container">
				<header class="section-head">
					<h2 id="apps-title">{t.apps.title}</h2>
				</header>
				<dl class="defs">
					{t.apps.items.map((a) => (
						<div>
							<dt>{a.title}</dt>
							<dd>{a.desc}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<section id="novedades" class="section" aria-labelledby="novedades-title">
			<div class="container">
				<header class="section-head">
					<h2 id="novedades-title">{t.novedades.title}</h2>
				</header>
				<div class="cols">
					{pairs(t.novedades).map((c) => (
						<div class:list={['col', `col--${c.tone}`]}>
							<h3>{c.title}</h3>
							<ul class="rows">
								{c.items.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		<section id="faq" class="section" aria-labelledby="faq-title">
			<div class="container">
				<header class="section-head">
					<h2 id="faq-title">{t.faq.title}</h2>
				</header>
				<div class="faq">
					{t.faq.items.map((f) => (
						<details>
							<summary>
								<span class="faq__mark mono" aria-hidden="true">
									+
								</span>
								{f.q}
							</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="cta-title">
			<div class="container">
				<div class="cta">
					<div>
						<h2 id="cta-title">{t.cta.title}</h2>
						<p>{t.cta.body}</p>
					</div>
					<div class="cta__actions">
						<a class="btn btn--primary" href={`${home}#configura`}>
							{t.cta.primary}
						</a>
						<a class="btn btn--secondary" {...linkAttrs('meshtastic')}>
							{t.cta.sister}
						</a>
					</div>
				</div>
				<p class="source" set:html={t.sourceHtml} />
			</div>
		</section>
	</main>

	<SiteFooter lang={lang} />
</Layout>

<style>
	.intro {
		padding-block: clamp(2rem, 1rem + 3.5vw, 4.5rem) var(--section-y);
	}

	.intro__eyebrow {
		color: var(--c-accent-2);
		margin-bottom: var(--s-5);
	}

	h1 {
		font-size: var(--t-h1);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.025em;
		font-variation-settings: 'opsz' 96;
	}

	.intro__lead {
		margin-top: var(--s-6);
		max-width: 44rem;
		font-size: var(--t-lg);
		line-height: 1.5;
		color: var(--c-text-2);
	}

	.intro__checked {
		margin-top: var(--s-4);
		color: var(--c-text-2);
	}

	.cols {
		display: grid;
		gap: var(--s-7);
	}

	@media (min-width: 48rem) {
		.cols {
			grid-template-columns: 1fr 1fr;
			gap: var(--s-8);
		}
	}

	.col {
		--tone: var(--c-accent-2);
		display: grid;
		gap: var(--s-4);
		align-content: start;
		padding-top: var(--s-4);
		border-top: 2px solid var(--tone);
	}

	.col--mt {
		--tone: var(--c-accent);
	}

	.col h3 {
		font-size: var(--t-h3);
	}

	.bullets {
		display: grid;
		gap: var(--s-2);
		color: var(--c-text-2);
	}

	.bullets li {
		padding-left: var(--s-4);
		position: relative;
	}

	.bullets li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 6px;
		height: 6px;
		border: 1.5px solid var(--tone);
		border-radius: 50%;
	}

	.rows {
		border-top: 1px solid var(--c-border);
	}

	.rows li {
		padding-block: var(--s-3);
		border-bottom: 1px solid var(--c-border);
		color: var(--c-text-2);
	}

	.callout {
		margin-top: var(--s-7);
		max-width: 44rem;
		padding: var(--s-4) var(--s-5);
		border: 1px solid var(--c-border-strong);
		border-radius: var(--r-card);
		background: var(--c-surface-2);
	}

	.callout :global(strong) {
		color: var(--c-text);
	}

	.table-wrap {
		overflow-x: auto;
		overscroll-behavior-x: contain;
	}

	.compare {
		width: 100%;
		min-width: 40rem;
		border-collapse: collapse;
		text-align: left;
		font-size: var(--t-sm);
	}

	.compare th,
	.compare td {
		padding: var(--s-3) var(--s-4) var(--s-3) 0;
		border-top: 1px solid var(--c-border);
		vertical-align: top;
	}

	.compare thead th {
		border-top: 0;
		font-family: var(--f-display);
		font-size: var(--t-lg);
		font-weight: 650;
	}

	.th--mc {
		color: var(--c-accent-2);
	}

	.th--mt {
		color: var(--c-accent);
	}

	.compare tbody th {
		width: 22%;
		font-weight: 600;
	}

	.compare td {
		color: var(--c-text-2);
	}

	.compare tbody tr:last-child > * {
		border-bottom: 1px solid var(--c-border);
	}

	.split {
		display: grid;
		gap: var(--s-6);
	}

	@media (min-width: 64rem) {
		.split {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: var(--s-8);
		}
	}

	.split h2 {
		font-size: var(--t-h2);
	}

	.prose {
		display: grid;
		gap: var(--s-4);
		max-width: 40rem;
		color: var(--c-text-2);
	}

	.defs {
		margin: 0;
		border-top: 1px solid var(--c-border);
	}

	.defs div {
		display: grid;
		gap: var(--s-1) var(--s-6);
		padding-block: var(--s-5);
		border-bottom: 1px solid var(--c-border);
	}

	@media (min-width: 48rem) {
		.defs div {
			grid-template-columns: 14rem 1fr;
		}
	}

	.defs dt {
		font-family: var(--f-display);
		font-size: var(--t-lg);
		font-weight: 650;
	}

	.defs dd {
		margin: 0;
		color: var(--c-text-2);
		max-width: 48rem;
	}

	.faq {
		border-top: 1px solid var(--c-border);
	}

	.faq details {
		border-bottom: 1px solid var(--c-border);
	}

	.faq summary {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		min-height: 44px;
		padding-block: var(--s-4);
		font-family: var(--f-display);
		font-size: var(--t-lg);
		font-weight: 650;
		cursor: pointer;
		list-style: none;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq__mark {
		display: inline-block;
		width: 1rem;
		color: var(--c-accent-2);
		font-size: var(--t-lg);
		transition: transform 200ms var(--ease-out);
	}

	.faq details[open] .faq__mark {
		transform: rotate(45deg);
	}

	.faq p {
		max-width: 48rem;
		padding: 0 0 var(--s-5) calc(1rem + var(--s-3));
		color: var(--c-text-2);
	}

	.cta {
		display: grid;
		gap: var(--s-6);
		padding: var(--s-6);
		border: 1px solid var(--c-border-strong);
		border-radius: var(--r-card);
		background: var(--c-surface-2);
	}

	@media (min-width: 64rem) {
		.cta {
			grid-template-columns: 1fr auto;
			align-items: center;
			padding: var(--s-7);
		}
	}

	.cta h2 {
		font-size: var(--t-h2);
	}

	.cta p {
		margin-top: var(--s-3);
		max-width: var(--measure);
		color: var(--c-text-2);
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	.source {
		margin-top: var(--s-6);
		max-width: 44rem;
		font-size: var(--t-xs);
		color: var(--c-text-2);
	}
</style>
