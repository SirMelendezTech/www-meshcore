---
import Layout from '../layouts/Layout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { homePath, languages, protocolsPath, ui, type Lang } from '../i18n/ui';
import { protocolos } from '../i18n/protocolos';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = protocolos[lang];
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
const home = homePath[lang];

// Two-column MeshCore/Meshtastic lists for the routing and news sections.
// MeshCore goes first: it's what this network runs.
const pairs = [
	{ id: 'ruteo', s: t.ruteo },
	{ id: 'novedades', s: t.novedades },
];
---

<Layout
	lang={lang}
	title={t.meta.title}
	description={t.meta.description}
	ogLocale={ui[lang].meta.ogLocale}
	alternates={protocolsPath}
>
	<SiteHeader lang={lang} base={home} altHref={protocolsPath[otherLang]} />

	<main id="contenido">
		<!-- Hero -->
		<section id="top" class="border-b border-[var(--line)] px-6 pb-14 pt-14 sm:pb-20 sm:pt-20">
			<div class="mx-auto max-w-6xl">
				<p class="font-mono text-sm text-[var(--pine)]">{t.hero.eyebrow}</p>
				<h1 class="font-display mt-3 text-5xl font-bold leading-[0.95] tracking-tight text-[var(--ink)] sm:text-6xl">
					{t.hero.title}
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--pine)]">{t.hero.lead}</p>
				<p class="mt-4 font-mono text-xs text-[var(--pine-soft)]">{t.hero.checked}</p>
			</div>
		</section>

		<!-- Respuesta corta -->
		<section id="corto" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.corto.title}</h2>
				<div class="mt-10 grid gap-8 md:grid-cols-2">
					{[
						{ s: t.corto.meshcore, accent: 'var(--signal)' },
						{ s: t.corto.meshtastic, accent: 'var(--vhf)' },
					].map(({ s, accent }) => (
						<div class="border-l-2 py-1 pl-5" style={`border-color: ${accent}`}>
							<h3 class="font-display text-xl font-semibold text-[var(--ink)]">{s.title}</h3>
							<ul class="mt-3 space-y-2 text-[var(--pine)]">
								{s.items.map((i) => <li>{i}</li>)}
							</ul>
						</div>
					))}
				</div>
				<p class="mt-10 max-w-2xl text-[var(--pine)]" set:html={t.corto.incompatHtml} />
			</div>
		</section>

		<!-- Tabla -->
		<section id="tabla" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.tabla.title}</h2>
				<div class="mt-10 overflow-x-auto">
					<table class="compare w-full min-w-[40rem] text-left text-sm">
						<thead>
							<tr>
								<th scope="col">{t.tabla.feature}</th>
								<th scope="col" class="text-[var(--signal)]">MeshCore</th>
								<th scope="col" class="text-[var(--vhf)]">Meshtastic</th>
							</tr>
						</thead>
						<tbody>
							{t.tabla.rows.map((r) => (
								<tr>
									<th scope="row">{r.k}</th>
									<td>{r.mc}</td>
									<td>{r.mt}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		{pairs.slice(0, 1).map(({ id, s }) => (
			<section id={id} class="border-b border-[var(--line)] px-6 py-20">
				<div class="mx-auto max-w-6xl">
					<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{s.title}</h2>
					<div class="mt-10 grid gap-10 md:grid-cols-2">
						{[s.meshcore, s.meshtastic].map((col) => (
							<div>
								<h3 class="font-display text-xl font-semibold text-[var(--ink)]">{col.title}</h3>
								<ul class="mt-2">
									{col.items.map((i) => <li class="step-row py-3 text-[var(--pine)]">{i}</li>)}
								</ul>
							</div>
						))}
					</div>
				</div>
			</section>
		))}

		<!-- Alcance -->
		<section id="alcance" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.alcance.title}</h2>
				<div class="space-y-4 text-[var(--pine)]">
					{t.alcance.paragraphs.map((p) => <p>{p}</p>)}
				</div>
			</div>
		</section>

		<!-- Cifrado -->
		<section id="cifrado" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.cifrado.title}</h2>
				<div class="mt-10 grid gap-10 md:grid-cols-2">
					{[t.cifrado.meshcore, t.cifrado.meshtastic].map((col) => (
						<div>
							<h3 class="font-display text-xl font-semibold text-[var(--ink)]">{col.title}</h3>
							<ul class="mt-2">
								{col.items.map((i) => <li class="step-row py-3 text-[var(--pine)]">{i}</li>)}
							</ul>
						</div>
					))}
				</div>
				<p class="spec-plate mt-10 max-w-2xl p-5 text-[var(--ink)]">{t.cifrado.ambos}</p>
			</div>
		</section>

		<!-- Apps -->
		<section id="apps" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.apps.title}</h2>
				<dl class="mt-10">
					{t.apps.items.map((a) => (
						<div class="step-row grid gap-1 py-5 sm:grid-cols-[0.6fr_1.4fr] sm:gap-6">
							<dt class="font-display text-lg font-semibold text-[var(--ink)]">{a.title}</dt>
							<dd class="text-[var(--pine)]">{a.desc}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		{pairs.slice(1).map(({ id, s }) => (
			<section id={id} class="border-b border-[var(--line)] px-6 py-20">
				<div class="mx-auto max-w-6xl">
					<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{s.title}</h2>
					<div class="mt-10 grid gap-10 md:grid-cols-2">
						{[s.meshcore, s.meshtastic].map((col) => (
							<div>
								<h3 class="font-display text-xl font-semibold text-[var(--ink)]">{col.title}</h3>
								<ul class="mt-2">
									{col.items.map((i) => <li class="step-row py-3 text-[var(--pine)]">{i}</li>)}
								</ul>
							</div>
						))}
					</div>
				</div>
			</section>
		))}

		<!-- FAQ -->
		<section id="faq" class="border-b border-[var(--line)] px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.faq.title}</h2>
				<div class="mt-10">
					{t.faq.items.map((f) => (
						<details class="step-row group py-5">
							<summary class="font-display cursor-pointer list-none text-lg font-semibold text-[var(--ink)]">
								<span class="mr-3 inline-block font-mono text-[var(--signal)] transition-transform group-open:rotate-45">+</span>{f.q}
							</summary>
							<p class="mt-3 max-w-3xl pl-7 text-[var(--pine)]">{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section id="comunidad" class="px-6 py-20">
			<div class="mx-auto max-w-6xl">
				<div class="spec-plate flex flex-col gap-8 p-8 sm:p-10 lg:flex-row lg:items-center lg:justify-between">
					<div class="max-w-lg">
						<h2 class="font-display text-3xl font-bold text-[var(--ink)] sm:text-4xl">{t.cta.title}</h2>
						<p class="mt-4 text-[var(--pine)]">{t.cta.body}</p>
					</div>
					<div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col">
						<a href={`${home}#configura`} class="btn-primary">{t.cta.primary}</a>
						<a href="https://prmsh.com" class="btn-secondary" rel="noopener">{t.cta.sister}</a>
					</div>
				</div>
				<p class="mt-8 max-w-2xl text-xs text-[var(--pine-soft)]" set:html={t.sourceHtml} />
			</div>
		</section>
	</main>

	<SiteFooter lang={lang} />
</Layout>

<style>
	.compare th,
	.compare td {
		border-top: 1px solid var(--line);
		padding: 0.85rem 1rem 0.85rem 0;
		vertical-align: top;
	}
	.compare thead th {
		border-top: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
	}
	.compare tbody th {
		color: var(--ink);
		font-weight: 600;
		width: 22%;
	}
	.compare td {
		color: var(--pine);
	}
	.compare tbody tr:last-child > * {
		border-bottom: 1px solid var(--line);
	}
	summary::-webkit-details-marker {
		display: none;
	}
</style>
