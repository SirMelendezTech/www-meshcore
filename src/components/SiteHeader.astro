---
import Wordmark from './Wordmark.astro';
import MobileNav from './MobileNav.svelte';
import ExternalIcon from './ExternalIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { links, linkAttrs } from '../config/links';
import { homePath, mapPath, protocolsPath, ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	/** Same page in the other locale, used by the language switch. */
	altHref: string;
}

const { lang, altHref } = Astro.props;
const t = ui[lang];
const home = homePath[lang];
// On the home page the section anchors stay on-page; elsewhere they lead home.
const here = Astro.url.pathname.replace(/\/?$/, '/');
const base = here === home ? '' : home;
const current = (href: string) => (href === here ? ('page' as const) : undefined);

// Sections of the home page, in page order.
const sections = [
	{ label: t.nav.inicio, href: `${base}#inicio` },
	{ label: t.nav.meshcore, href: `${base}#meshcore` },
	{ label: t.nav.como, href: `${base}#como-funciona` },
	{ label: t.nav.recursos, href: `${base}#recursos` },
	{ label: t.nav.comunidad, href: `${base}#comunidad` },
];
// Standalone pages, kept apart so it's clear they leave the home page.
const pages = [
	{ label: t.nav.mapa, href: mapPath[lang], 'aria-current': current(mapPath[lang]) },
	{
		label: t.nav.comparar,
		href: protocolsPath[lang],
		'aria-current': current(protocolsPath[lang]),
	},
];
const join = { label: t.nav.join, ...linkAttrs('discord') };
const back = { label: t.nav.back, ...linkAttrs('prmsh') };
const langSwitch = { label: t.switchTo.label, href: altHref, lang: t.switchTo.lang };
---

<!-- Family bar: where this site sits inside PRMSH, and the way back. Scrolls away. -->
<div class="family">
	<div class="container family__bar">
		<nav aria-label="PRMSH" class="family__crumbs mono">
			<ol>
				<li>
					<a href={links.prmsh.url} title={t.nav.back}>
						PRMSH Community
					</a>
				</li>
				<li aria-current="page">MeshCore Puerto Rico</li>
			</ol>
		</nav>
		<div class="family__tools">
			<ThemeToggle lang={lang} />
			<a
				class="family__lang mono"
				href={langSwitch.href}
				hreflang={langSwitch.lang}
				lang={langSwitch.lang}
				title={t.switchTo.title}
				data-lang-switch
			>
				{langSwitch.label}
			</a>
		</div>
	</div>
</div>

<header class="header">
	<div class="container header__bar">
		<a class="header__brand" href={`${base}#inicio`} aria-label={t.a11y.home}>
			<Wordmark />
			<span class="header__name">
				MeshCore <span>Puerto Rico</span>
			</span>
		</a>

		<nav class="header__nav" aria-label={t.a11y.primaryNav}>
			<ul>
				{sections.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
				<li class="header__rule" aria-hidden="true"></li>
				{pages.map((item) => (
					<li>
						<a href={item.href} aria-current={item['aria-current']}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<a class="btn btn--primary header__cta" {...linkAttrs('discord')}>
			{t.nav.join}
			<ExternalIcon />
			<span class="visually-hidden">{t.a11y.newTab}</span>
		</a>

		<div class="header__mobile">
			<MobileNav
				client:media="(max-width: 79.99rem)"
				items={sections}
				secondary={[...pages, back, langSwitch]}
				cta={join}
				desktopQuery="(min-width: 80rem)"
				openLabel={t.a11y.menuOpen}
				closeLabel={t.a11y.menuClose}
				newTabLabel={t.a11y.newTab}
				navLabel={t.a11y.primaryNav}
			/>
		</div>
	</div>
</header>

<script>
	// Keep the reader on the same section when switching languages; both
	// locales share the same section ids.
	document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) =>
		link.addEventListener('click', () => {
			link.hash = window.location.hash;
		}),
	);
</script>

<style>
	.family {
		border-bottom: 1px solid var(--c-border);
		background: var(--c-surface);
	}

	.family__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
	}

	.family__tools {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex: none;
	}

	.family__crumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		color: var(--c-text-2);
	}

	.family__crumbs li {
		display: inline-flex;
		align-items: center;
	}

	.family__crumbs li + li::before {
		content: '/';
		padding-inline: var(--s-2);
		color: var(--c-border-strong);
	}

	.family__crumbs li[aria-current] {
		color: var(--c-text);
	}

	.family__crumbs a,
	.family__lang {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--c-text-2);
		text-decoration: underline;
		text-decoration-color: var(--c-border-strong);
		text-underline-offset: 4px;
		transition: color 160ms var(--ease-out);
	}

	.family__lang {
		text-decoration: none;
	}

	.family__crumbs a:hover,
	.family__lang:hover {
		color: var(--c-text);
		text-decoration-color: var(--c-text);
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--c-header);
		border-bottom: 1px solid var(--c-border);
		backdrop-filter: saturate(1.2) blur(8px);
	}

	.header__bar {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--s-6);
		min-height: 4.25rem;
	}

	.header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		margin-right: auto;
		text-decoration: none;
		color: var(--c-text);
	}

	.header__name {
		font-family: var(--f-display);
		font-weight: 750;
		font-size: 1.25rem;
		letter-spacing: 0.01em;
		font-variation-settings: 'opsz' 32;
		line-height: 1;
		white-space: nowrap;
	}

	.header__name span {
		font-weight: 500;
		color: var(--c-text-2);
	}

	.header__nav ul {
		display: flex;
		align-items: center;
		gap: var(--s-1);
	}

	.header__nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--s-2);
		color: var(--c-text-2);
		text-decoration: none;
		font-size: var(--t-sm);
		font-weight: 500;
		white-space: nowrap;
		border-radius: var(--r-control);
		transition: color 160ms var(--ease-out);
	}

	.header__nav a:hover,
	.header__nav a[aria-current='page'] {
		color: var(--c-text);
	}

	.header__nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--c-accent-2);
		text-underline-offset: 6px;
		text-decoration-thickness: 2px;
	}

	.header__rule {
		width: 1px;
		height: 1.25rem;
		margin-inline: var(--s-2);
		background: var(--c-border);
	}

	.header__cta {
		min-height: 44px;
		padding: 0.5rem 1rem;
		font-size: var(--t-sm);
		white-space: nowrap;
	}

	.header__mobile {
		display: none;
	}

	@media (max-width: 79.99rem) {
		.header__nav,
		.header__cta {
			display: none;
		}

		.header__mobile {
			display: block;
		}
	}

	/* Phones: the header already names this site, so the bar keeps only the way back. */
	@media (max-width: 29.99rem) {
		.family__crumbs li[aria-current] {
			display: none;
		}
	}

	/* Very narrow phones: keep the brand on one line. */
	@media (max-width: 22.5rem) {
		.header__name span {
			display: none;
		}
	}
</style>
