---
import DotField from './svelte-bits/DotField.svelte';
---

<!-- Decorative node grid behind a section; parent needs `relative overflow-hidden`. -->
<div class="dot-field-backdrop pointer-events-none absolute inset-0 hidden sm:block" aria-hidden="true">
	<DotField
		client:visible
		dotRadius={2}
		dotSpacing={22}
		cursorRadius={260}
		bulgeStrength={28}
		glowRadius={140}
		gradientFrom="rgba(143, 166, 150, 0.32)"
		gradientTo="rgba(95, 163, 189, 0.22)"
		glowColor="#141f18"
	/>
</div>

<style>
	.dot-field-backdrop {
		mask-image: radial-gradient(ellipse 70% 80% at 85% 50%, black 30%, transparent 75%);
	}
</style>
