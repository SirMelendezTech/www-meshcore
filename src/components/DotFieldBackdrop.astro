---
import DotField from './svelte-bits/DotField.svelte';
---

<!-- Decorative node grid behind a section; parent needs `relative overflow-hidden`.
     The mask keeps the dots in the empty top-right corner beside the heading so
     the cursor bulge never moves behind text people are reading. -->
<div class="dot-field-backdrop pointer-events-none absolute inset-0 hidden sm:block" aria-hidden="true">
	<DotField
		client:visible
		dotRadius={2}
		dotSpacing={22}
		cursorRadius={260}
		bulgeStrength={18}
		glowRadius={140}
		gradientFrom="rgba(143, 166, 150, 0.32)"
		gradientTo="rgba(95, 163, 189, 0.22)"
		glowColor="#141f18"
	/>
</div>

<style>
	.dot-field-backdrop {
		mask-image: radial-gradient(ellipse 45% 32% at 88% 12%, black 25%, transparent 80%);
	}
</style>
