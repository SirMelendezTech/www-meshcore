---
import LineWaves from './svelte-bits/LineWaves.svelte';
---

<!-- Decorative signal waves under the "alcance" heading, large screens only. -->
<div class="line-waves-panel mt-10 hidden h-56 lg:block" aria-hidden="true">
	<LineWaves
		client:visible
		speed={0.15}
		innerLineCount={18}
		outerLineCount={22}
		warpIntensity={0.8}
		rotation={-20}
		colorCycleSpeed={0.4}
		brightness={0.14}
		color1="#5fa3bd"
		color2="#5fa3bd"
		color3="#8fa696"
		enableMouseInteraction={false}
	/>
</div>

<style>
	.line-waves-panel {
		mask-image: radial-gradient(ellipse 60% 55% at 40% 50%, black 35%, transparent 80%);
	}
</style>
