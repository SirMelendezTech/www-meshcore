---
import { ui, type Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const e = ui[lang].explore;

// Line glyphs, one per feature, drawn in the same vocabulary as the map:
// circles are companions, squares are repeaters, lime marks the active node.
const glyphs: Record<string, string> = {
	network: `
		<path d="M10 34 24 14 40 30 54 12M24 14 40 30M10 34 40 30" class="g-link"/>
		<circle cx="10" cy="34" r="4" class="g-node"/>
		<rect x="20" y="10" width="8" height="8" class="g-node"/>
		<rect x="36" y="26" width="8" height="8" class="g-node"/>
		<circle cx="54" cy="12" r="4" class="g-hot"/>`,
	devices: `
		<rect x="14" y="18" width="30" height="22" rx="1" class="g-node"/>
		<rect x="20" y="24" width="10" height="10" class="g-link"/>
		<path d="M44 22h6V6" class="g-node"/>
		<path d="M50 6c3 2 4 5 4 8M50 6c-3 2-4 5-4 8" class="g-link"/>
		<circle cx="38" cy="34" r="2" class="g-hot"/>`,
	learning: `
		<path d="M8 10l16-4 16 4 16-4v30l-16 4-16-4-16 4z" class="g-node"/>
		<path d="M24 6v30M40 10v30" class="g-link"/>
		<path d="M12 26c4-3 8-3 10 0M42 22c4-4 8-3 10-1M28 18c3-2 7-2 9 1" class="g-link"/>
		<circle cx="47" cy="30" r="2.5" class="g-hot"/>`,
	community: `
		<path d="M32 24 12 12M32 24 52 12M32 24 12 38M32 24 52 38M12 12 12 38M52 12 52 38" class="g-link"/>
		<circle cx="12" cy="12" r="4" class="g-node"/>
		<circle cx="52" cy="12" r="4" class="g-node"/>
		<circle cx="12" cy="38" r="4" class="g-node"/>
		<circle cx="52" cy="38" r="4" class="g-node"/>
		<rect x="28" y="20" width="8" height="8" class="g-hot"/>`,
};
---

<section id="meshcore" class="section" aria-labelledby="explore-title">
	<div class="container">
		<div class="intro">
			<header class="section-head">
				<h2 id="explore-title">{e.title}</h2>
				<p>{e.body}</p>
			</header>
			<div class="intro__about">
				<p set:html={e.aboutHtml} />
				<p class="intro__note" set:html={e.notOfficialHtml} />
			</div>
		</div>

		<h3 class="features__title">{e.featuresTitle}</h3>
		<ul class="features">
			{e.features.map((f) => (
				<li class="feature">
					<svg
						class="feature__glyph"
						viewBox="0 0 64 48"
						fill="none"
						aria-hidden="true"
						focusable="false"
						set:html={glyphs[f.id]}
					/>
					<h4 id={`feature-${f.id}`}>{f.title}</h4>
					<p>{f.body}</p>
					<a class="inline-link feature__link" href={f.href}>
						{f.cta}
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.intro {
		display: grid;
		gap: var(--s-6);
	}

	@media (min-width: 64rem) {
		.intro {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			gap: var(--s-8);
			align-items: start;
		}

		.intro .section-head {
			margin-bottom: 0;
		}

		.intro__about {
			padding-top: var(--s-3);
		}
	}

	.intro .section-head {
		margin-bottom: 0;
	}

	.intro__about {
		display: grid;
		gap: var(--s-4);
		max-width: 38rem;
	}

	.intro__about p:first-child {
		font-size: var(--t-lg);
		line-height: 1.55;
	}

	.intro__note {
		padding-left: var(--s-4);
		border-left: 2px solid var(--c-accent-2);
		color: var(--c-text-2);
		font-size: var(--t-sm);
	}

	.features__title {
		margin-top: var(--s-9);
		margin-bottom: var(--s-6);
		font-size: var(--t-h3);
	}

	/* Ruled grid, like a chart's legend table: shared hairlines, no floating cards. */
	.features {
		display: grid;
		border-top: 1px solid var(--c-border);
	}

	@media (min-width: 48rem) {
		.features {
			grid-template-columns: 1fr 1fr;
		}

		.feature:nth-child(odd) {
			border-right: 1px solid var(--c-border);
			padding-right: var(--s-6);
		}

		.feature:nth-child(even) {
			padding-left: var(--s-6);
		}
	}

	@media (min-width: 72rem) {
		.features {
			grid-template-columns: repeat(4, 1fr);
		}

		.feature,
		.feature:nth-child(odd),
		.feature:nth-child(even) {
			padding-inline: var(--s-5);
			border-right: 1px solid var(--c-border);
		}

		.feature:first-child {
			padding-left: 0;
		}

		.feature:last-child {
			border-right: 0;
			padding-right: 0;
		}
	}

	.feature {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
		padding-block: var(--s-6);
		border-bottom: 1px solid var(--c-border);
	}

	.feature__glyph {
		width: 64px;
		height: 48px;
		margin-bottom: var(--s-2);
	}

	.feature__glyph :global(.g-node) {
		stroke: var(--c-accent-2);
		stroke-width: 1.75;
		fill: var(--c-bg);
		stroke-linejoin: round;
	}

	.feature__glyph :global(.g-link) {
		stroke: var(--c-line);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.feature__glyph :global(.g-hot) {
		fill: var(--c-accent);
	}

	.feature h4 {
		font-family: var(--f-display);
		font-size: var(--t-lg);
		font-weight: 650;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.feature p {
		color: var(--c-text-2);
		flex: 1;
	}

	.feature__link {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		min-height: 44px;
		font-weight: 600;
	}
</style>
