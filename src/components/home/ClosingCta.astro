---
import ExternalIcon from '../ExternalIcon.astro';
import { linkAttrs } from '../../config/links';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const c = t.closing;
---

<section class="section closing" aria-labelledby="closing-title">
	<div class="container closing__inner">
		<div class="closing__island"></div>
		<div class="closing__text">
			<h2 id="closing-title">{c.title}</h2>
			<p>{c.body}</p>
		</div>
		<div class="closing__actions">
			<a class="btn btn--primary" href="#recursos">
				{c.resources}
			</a>
			<a class="btn btn--secondary btn--blue" {...linkAttrs('discord')}>
				{c.discord}
				<ExternalIcon />
				<span class="visually-hidden">{t.a11y.newTab}</span>
			</a>
			<a class="btn btn--secondary" {...linkAttrs('prmsh')}>
				{c.back}
			</a>
		</div>
	</div>
</section>

<style>
	.closing__inner {
		position: relative;
		display: grid;
		gap: var(--s-6);
		isolation: isolate;
	}

	.closing__island {
		position: absolute;
		z-index: -1;
		right: var(--gutter);
		bottom: -2rem;
		width: min(46rem, 70%);
		aspect-ratio: 1544 / 537;
		background: var(--terrain) center / 100% 100% no-repeat;
		opacity: var(--terrain-fade);
		pointer-events: none;
	}

	.closing__text {
		display: grid;
		gap: var(--s-4);
		max-width: 40rem;
	}

	.closing h2 {
		font-size: var(--t-h2);
	}

	.closing p {
		color: var(--c-text-2);
		font-size: var(--t-lg);
		max-width: var(--measure);
	}

	.closing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	@media (max-width: 29.99rem) {
		.closing__actions .btn {
			flex: 1 1 100%;
		}

		.closing__island {
			width: 100%;
			right: 0;
			opacity: calc(var(--terrain-fade) * 0.6);
		}
	}
</style>
