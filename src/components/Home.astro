---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Hero from './home/Hero.astro';
import Explore from './home/Explore.astro';
import HowItWorks from './home/HowItWorks.astro';
import Resources from './home/Resources.astro';
import Community from './home/Community.astro';
import ClosingCta from './home/ClosingCta.astro';
import { homePath, languages, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
---

<Layout lang={lang}>
	<SiteHeader lang={lang} altHref={homePath[otherLang]} />
	<main id="contenido">
		<Hero lang={lang} />
		<Explore lang={lang} />
		<HowItWorks lang={lang} />
		<Resources lang={lang} />
		<Community lang={lang} />
		<ClosingCta lang={lang} />
	</main>
	<SiteFooter lang={lang} />
</Layout>
