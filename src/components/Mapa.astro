---
import Layout from '../layouts/Layout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import ExternalIcon from './ExternalIcon.astro';
import { coreScopeEmbedUrl, linkAttrs } from '../config/links';
import { languages, mapPath, ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const m = t.mapa;
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
const corescope = linkAttrs('corescope');
---

<Layout lang={lang} title={m.meta.title} description={m.meta.description} alternates={mapPath}>
	<SiteHeader lang={lang} altHref={mapPath[otherLang]} />

	<main id="contenido">
		<section class="intro" aria-labelledby="map-title">
			<div class="container intro__grid">
				<div>
					<p class="intro__eyebrow mono">{m.eyebrow}</p>
					<h1 id="map-title">{m.title}</h1>
					<p class="intro__lead">{m.lead}</p>
				</div>
				<div class="intro__actions">
					<a class="btn btn--primary" {...corescope}>
						{m.open}
						<ExternalIcon />
						<span class="visually-hidden">{t.a11y.newTab}</span>
					</a>
					<a class="inline-link" href="#aparecer">
						{m.howLink}
					</a>
				</div>
			</div>
		</section>

		<!-- Wide live map. Leave page margin above and below so touch users can still scroll past it. -->
		<section class="stage" aria-label={m.frameTitle}>
			<!-- The embedded map holds many focusable markers; let keyboard users jump past it. -->
			<a href="#aparecer" class="skip-map">
				{m.skipMap}
			</a>
			<div class="frame">
				<iframe
					src={coreScopeEmbedUrl}
					title={m.frameTitle}
					loading="eager"
					referrerpolicy="strict-origin-when-cross-origin"
					allow="fullscreen; geolocation"
				></iframe>
			</div>
			<p class="container stage__caption">
				{m.caption}
				<a class="inline-link" {...corescope}>
					{m.captionLink}
					<span class="visually-hidden"> {t.a11y.newTab}</span>
				</a>
				.
			</p>
		</section>

		<section id="aparecer" class="section" aria-labelledby="how-title">
			<div class="container">
				<header class="section-head">
					<h2 id="how-title">{m.how.title}</h2>
					<p>{m.how.intro}</p>
				</header>
				<ul class="items">
					{m.how.items.map((i) => (
						<li>
							<h3>{i.title}</h3>
							<p>{i.desc}</p>
						</li>
					))}
				</ul>
				<p class="more">
					{m.how.more}
					<a class="inline-link" {...corescope}>
						{m.open}
						<span class="visually-hidden"> {t.a11y.newTab}</span>
					</a>
					.
				</p>
			</div>
		</section>
	</main>

	<SiteFooter lang={lang} />
</Layout>

<style>
	.intro {
		padding-block: clamp(2rem, 1rem + 3.5vw, 4rem) var(--s-6);
	}

	.intro__grid {
		display: grid;
		gap: var(--s-6);
		align-items: end;
	}

	@media (min-width: 64rem) {
		.intro__grid {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: var(--s-8);
		}
	}

	.intro__eyebrow {
		color: var(--c-accent-2);
		margin-bottom: var(--s-4);
	}

	h1 {
		font-size: var(--t-h2);
		font-weight: 700;
		font-variation-settings: 'opsz' 96;
	}

	.intro__lead {
		margin-top: var(--s-4);
		max-width: 38rem;
		color: var(--c-text-2);
		font-size: var(--t-lg);
		line-height: 1.5;
	}

	.intro__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s-3) var(--s-5);
	}

	.stage {
		position: relative;
		padding-bottom: var(--s-6);
	}

	.skip-map {
		position: absolute;
		left: var(--s-4);
		top: var(--s-4);
		z-index: 10;
		padding: var(--s-3) var(--s-4);
		background: var(--c-accent);
		color: var(--c-on-accent);
		font-weight: 600;
		border-radius: var(--r-control);
		transform: translateY(-200%);
		opacity: 0;
	}

	.skip-map:focus {
		transform: none;
		opacity: 1;
	}

	.frame {
		max-width: 96rem;
		margin-inline: auto;
		/* Viewport minus the header, with a floor so short laptop screens still get a usable map. */
		height: max(28rem, calc(100svh - 12rem));
		border-block: 1px solid var(--c-border-strong);
		background: var(--c-surface);
	}

	.frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (min-width: 48rem) {
		.frame {
			width: calc(100% - var(--gutter) * 2);
			border-inline: 1px solid var(--c-border-strong);
			border-radius: var(--r-card);
		}
	}

	/* Phones: shorter frame so there is always page to grab above and below it. */
	@media (max-width: 47.99rem) {
		.frame {
			height: 70svh;
		}
	}

	.stage__caption {
		margin-top: var(--s-3);
		font-size: var(--t-sm);
		color: var(--c-text-2);
	}

	.items {
		display: grid;
		gap: var(--s-6);
	}

	@media (min-width: 48rem) {
		.items {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.items li {
		display: grid;
		gap: var(--s-2);
		align-content: start;
		padding-top: var(--s-4);
		border-top: 1px solid var(--c-border);
	}

	.items h3 {
		font-size: var(--t-h3);
	}

	.items p {
		color: var(--c-text-2);
	}

	.more {
		margin-top: var(--s-7);
		max-width: 44rem;
		color: var(--c-text-2);
	}
</style>
