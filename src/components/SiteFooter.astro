---
import { ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const t = ui[Astro.props.lang];
---

<footer class="border-t border-[var(--line)] px-6 py-10">
	<div class="mx-auto max-w-6xl text-sm text-[var(--pine-soft)]">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<p>{t.footer.note}</p>
		<div class="flex gap-5">
			<a href="https://discord.gg/3v6rRhNRpD" class="hover:text-[var(--ink)]">Discord</a>
			<a href="https://chat.whatsapp.com/HwCszML0lrv7Ld2N3Tc6QT" class="hover:text-[var(--ink)]" rel="noopener">WhatsApp</a>
			<a href="https://prmsh.com" class="hover:text-[var(--ink)]">PRMSH</a>
			<a href="https://github.com/SirMelendezTech/www-meshcore" class="hover:text-[var(--ink)]">GitHub</a>
		</div>
	</div>
	<p class="mt-6 text-xs">{t.footer.disclaimer}</p>
	</div>
</footer>
